.coins-inline{background:var(--card);border-radius:18px;padding:14px 18px;font-weight:900;box-shadow:var(--tile-shadow);border:2px solid var(--tile-border);white-space:nowrap}
.modal{position:fixed;inset:0;background:rgba(60,50,80,.42);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:90;opacity:0;pointer-events:none;transition:opacity .3s;padding:20px}
