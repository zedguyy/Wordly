function checkSelection(){if(!currentCells.length)return;const str=currentCells.map(o=>G.grid[o.r][o.c]).join('');const rev=str.split('').reverse().join('');const idx=G.words.findIndex(w=>!w.found&&(w.word===str||w.word===rev));if(idx!==-1){foundWord(idx);}else{if(currentCells.length>1){playInvalid();currentCells.forEach(o=>{const el=cellEl(o.r,o.c);if(el){el.classList.add('shake');setTimeout(()=>el.classList.remove('shake'),360);}});}clearSelection();}}
function foundWord(idx){const w=G.words[idx];w.found=true;G.foundCount++;S.wordsTotal++;w.cells.forEach(o=>{const el=cellEl(o.r,o.c);if(el){el.classList.remove('selecting');el.classList.add('found');el.style.background=w.color;el.style.color='#fff';el.style.boxShadow='0 3px 0 rgba(0,0,0,.14),0 6px 16px '+w.color+'88';}});if(selectLine)selectLine.style.display='none';lastLen=0;currentCells=[];const pill=$('pill-'+idx);if(pill){pill.classList.add('found');pill.style.background=w.color;pill.style.borderColor=w.color;}playFound();buzz(30);try{const rs=w.cells.map(o=>cellEl(o.r,o.c).getBoundingClientRect());const cx=rs.reduce((s,b)=>s+b.left+b.width/2,0)/rs.length,cy=rs.reduce((s,b)=>s+b.top+b.height/2,0)/rs.length;burst(cx,cy,w.color,20);burst(cx,cy,'#FFFFFF',7);}catch(e){}S.coins+=5;save();updateCoinsUI();updateProgress();if(G.foundCount>=G.words.length)setTimeout(completeLevel,650);}
