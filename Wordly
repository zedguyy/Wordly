body[data-theme="mint"]{--bg1:#ECFDF5;--bg2:#D1FAE5;--bg3:#E0F2FE;--accent:#10B981;--accent2:#06B6D4;--accent-gradient:linear-gradient(135deg,#10B981,#06B6D4);--accent-shadow:0 8px 20px rgba(16,185,129,.35);--text:#2F4A42;--tile-text:#2F4A42;--blobA:#A7F3D0;--blobB:#BAE6FD;--blobC:#6EE7B7}
body[data-theme="peach"]{--bg1:#FFF7ED;--bg2:#FFEDD5;--bg3:#FFE4E6;--accent:#F97316;--accent2:#EF4444;--accent-gradient:linear-gradient(135deg,#F97316,#EF4444);--accent-shadow:0 8px 20px rgba(249,115,22,.35);--text:#5A3F35;--tile-text:#5A3F35;--blobA:#FED7AA;--blobB:#FECACA;--blobC:#FDBA74}
body[data-theme="ocean"]{--bg1:#E0F2FE;--bg2:#DBEAFE;--bg3:#E0E7FF;--accent:#0EA5E9;--accent2:#6366F1;--accent-gradient:linear-gradient(135deg,#0EA5E9,#6366F1);--accent-shadow:0 8px 20px rgba(14,165,233,.35);--text:#334155;--tile-text:#334155;--blobA:#BAE6FD;--blobB:#C7D2FE;--blobC:#7DD3FC}
body[data-theme="midnight"]{--bg1:#1E1B2E;--bg2:#2A2745;--bg3:#1A1830;--card:#2E2B48;--text:#FFFFFF;--text-soft:#9B93B8;--accent:#8B5CF6;--accent2:#EC4899;--accent-gradient:linear-gradient(135deg,#8B5CF6,#EC4899);--accent-shadow:0 8px 20px rgba(139,92,246,.4);--tile-bg:#3B3860;--tile-text:#FFFFFF;--tile-border:rgba(255,255,255,.08);--tile-shadow:0 2px 0 rgba(0,0,0,.3),0 6px 14px rgba(0,0,0,.3);--progress-bg:#3B3860;--shadow-card:0 10px 30px rgba(0,0,0,.3);--blobA:#8B5CF6;--blobB:#EC4899;--blobC:#6366F1}
body{font-family:'Nunito',sans-serif;color:var(--text);min-height:100dvh;overflow-x:hidden;transition:background .4s}
