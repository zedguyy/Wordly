.cell.found{color:#fff!important;animation:pop .45s cubic-bezier(.34,1.56,.64,1)}
@keyframes pop{0%{transform:scale(1)}40%{transform:scale(1.28) rotate(4deg)}70%{transform:scale(.94)}100%{transform:scale(1)}}
.cell.hint-flash{animation:hintP .6s ease-in-out 3}
@keyframes hintP{0%,100%{box-shadow:var(--tile-shadow)}50%{box-shadow:0 0 0 6px rgba(255,214,107,.9),0 0 22px rgba(255,214,107,.9);transform:scale(1.12);background:#FFF3C4}}
.cell.shake{animation:shake .32s}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
#lineSvg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2;overflow:visible}
#wordList{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:14px 0 6px;min-height:40px}
.word-pill{background:var(--card);padding:9px 16px;border-radius:999px;font-weight:900;font-size:13px;letter-spacing:1.8px;color:var(--text);box-shadow:var(--tile-shadow);transition:all .3s;border:2px solid var(--tile-border)}
.word-pill.found{color:#fff!important;transform:scale(.94);border-color:rgba(255,255,255,.4)}
.word-pill.found::after{content:' ✓';font-weight:900}
.game-footer{display:flex;align-items:center;gap:10px;margin-top:8px}
.hint-btn{flex:1;background:var(--card);border:2px solid var(--progress-bg);color:var(--text);border-radius:18px;padding:14px;font-weight:900;font-size:16px;cursor:pointer;box-shadow:var(--tile-shadow);transition:transform .15s}
.hint-btn:active{transform:scale(.95)}
