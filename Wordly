function updateSoundIcon(){$('soundQuickBtn').textContent=S.sound?'🔊':'🔇';}
$('soundQuickBtn').onclick=()=>{S.sound=!S.sound;save();updateSoundIcon();if(S.sound)playClick();};
document.querySelectorAll('.modal').forEach(m=>m.addEventListener('click',e=>{if(e.target===m){if(m.id==='pauseModal')return;m.classList.remove('show');}}));
window.addEventListener('pointermove',onMove,{passive:true});window.addEventListener('pointerup',onUp);window.addEventListener('pointercancel',onUp);
$('gridWrap').addEventListener('touchmove',e=>e.preventDefault(),{passive:false});
$('gridWrap').addEventListener('contextmenu',e=>e.preventDefault());
document.addEventListener('pointerdown',()=>ensureAudio(),{once:true});
document.addEventListener('visibilitychange',()=>{if(document.hidden&&$('gameScreen').classList.contains('active')&&!G.paused&&G.words.length&&G.foundCount<G.words.length)pauseGame();});
applyTheme();initFloats();initSparkles();initLogo();updateHome();updateSoundIcon();
if('serviceWorker' in navigator){window.addEventListener('load',()=>{navigator.serviceWorker.register('sw.js').catch(()=>{});});}
</script>
</body>
</html>
