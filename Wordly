.cell{aspect-ratio:1;background:var(--tile-bg);display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--tile-text);box-shadow:var(--tile-shadow);cursor:pointer;transition:transform .12s,background .15s,color .15s,box-shadow .15s;border:2px solid var(--tile-border)}
#grid.size-s .cell{font-size:27px;border-radius:16px}
