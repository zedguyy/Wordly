function startLevel(num,isDaily){G.isDaily=isDaily;G.level=num;let puzzle;if(isDaily){const rand=mulberry32(getDailySeed());const d=new Date();const size=7+(d.getDate()%3);const count=6+(d.getDay()%3);puzzle=generatePuzzle({size,count,diag:true,back:true,min:3,max:6},rand);$('levelLabel').textContent='Daily Puzzle';const b=$('challengeBadge');b.classList.remove('hidden');b.textContent='📅 '+getTodayStr()+' • 🔥 '+S.streak;}else{const cfg=getConfig(num);puzzle=generatePuzzle(cfg,Math.random);$('levelLabel').textContent='Level '+num;const b=$('challengeBadge');if(num%5===0){b.classList.remove('hidden');b.textContent='⚡ CHALLENGE • 2x Coins';}else b.classList.add('hidden');}applyLevelBackground(num,isDaily);G.size=puzzle.size;G.grid=puzzle.grid;G.words=puzzle.placed;G.foundCount=0;G.hintsUsed=0;G.paused=false;G.elapsed=0;G.startTime=Date.now();selecting=false;startCell=null;currentCells=[];lastLen=0;renderGrid();renderWordList();updateProgress();updateTimerDisplay();startTimer();showScreen('gameScreen');updateCoinsUI();hideAllModals();}
